# macOS
.DS_Store

# Obsidian per-device UI state (do NOT sync — causes cross-device conflicts)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/.DS_Store

# Obsidian trash
.trash/

# Scratch
*.tmp

# Xcode per-user state (never sync — like .obsidian workspace files)
xcuserdata/
*.xcuserstate
DerivedData/
*.xcscmblueprint
